              }
            }
          ]
        },
        "caseState": {
          "symptoms": ["头疼", "发烧"],
          "duration": null,
          "age": null,
          "revision": 1,
          "missingFields": ["duration", "age"]
        },
        "mutation": {
          "changed": true
        }
      }
    }
  ]
}
